# LLM Provider Selection: 'auto', 'gemini', 'openai', or 'offline'
LLM_PROVIDER=auto

# Google Gemini API Configuration (100% FREE Tier from ai.google.dev)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI API Configuration (Paid tier from platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Database Configuration (PostgreSQL with pgvector)
# For local portable instance on port 5434:
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5434/social_value_db
# For Docker Compose instance on default port 5432:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/social_value_db

# Application Configuration
APP_NAME=Infosys Social Value RFP Response Builder POC
APP_ENV=development
APP_PORT=8000
DEBUG=True

# --- Security ---
# Long random string (>= 32 chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# One-time bootstrap of the first superadmin when the users table is empty (remove after first start)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=https://nice-moss-0c037f310.3.azurestaticapps.net,http://localhost:5173,http://127.0.0.1:5173
