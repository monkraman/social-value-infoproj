# LLM Provider Selection: 'auto', 'azure', 'gemini', 'openai', or 'offline'
LLM_PROVIDER=auto
# Providers tried next, in order, when the first is out of quota or down (e.g. gemini,openai)
LLM_FALLBACK=
# Embeddings provider: 'auto' (Gemini, else OpenAI, else Azure), or 'gemini', 'openai', 'azure'.
# Changing it means re-indexing documents.
EMBEDDING_PROVIDER=auto

# Azure OpenAI (keys only here locally, and in App Service settings / Key Vault when deployed)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-10-21
# Embedding model deployment, needed when EMBEDDING_PROVIDER=azure (e.g. text-embedding-3-small)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Leave unset for reasoning models (gpt-5, o-series); they accept only their default temperature
# AZURE_OPENAI_TEMPERATURE=0.2

# Google Gemini API Configuration (100% FREE Tier from ai.google.dev)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI API Configuration (Paid tier from platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# Development only: allow meaningless placeholder vectors when no AI key is set
EMBEDDING_ALLOW_SYNTHETIC=false

# Database Configuration (PostgreSQL with pgvector)
# For local portable instance on port 5434:
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5434/social_value_db
# For Docker Compose instance on default port 5432:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/social_value_db
# Connections per worker process; keep workers x (pool + overflow) under the database limit.
# Azure PostgreSQL Burstable B1ms with 2 workers: DB_POOL_SIZE=5, DB_MAX_OVERFLOW=5
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Interactive API documentation at /docs (set false on a public deployment)
ENABLE_API_DOCS=true

# Application Configuration
APP_NAME=Infosys Social Value RFP Response Builder POC
APP_ENV=development
APP_PORT=8000
DEBUG=True

# --- Security ---
# Long random string (>= 32 chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# One-time bootstrap of the first superadmin when the users table is empty (remove after first start)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=https://nice-moss-0c037f310.3.azurestaticapps.net,https://socialvalue.monkspaces.com,https://frontend-social-value-tool.vercel.app,http://localhost:5173,http://127.0.0.1:5173
